---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import DocPager from '../components/DocPager.astro';
import TagList from '../components/TagList.astro';
import DocList from '../components/DocList.astro';
import PageFeedback from '../components/PageFeedback.astro';
import { DOC_NAV, activeNavId, getDocSiblings } from '../lib/nav';
import { getRelatedByTags } from '../lib/docs';
import { tagsIndexHref } from '../lib/tag-utils';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Frontmatter {
  title: string;
  description?: string;
  /** Injected by remark-reading-time.mjs */
  minutesRead?: string;
  /** Injected by remark-last-updated.mjs */
  lastUpdated?: string | null;
  tags?: string[];
}

interface Props {
  frontmatter: Frontmatter;
  headings?: Heading[];
}

const { frontmatter, headings = [] } = Astro.props;
const {
  title,
  description = '',
  minutesRead,
  lastUpdated = null,
  tags = [],
} = frontmatter;

const pathname = Astro.url.pathname;
const currentId = activeNavId(pathname);
const { prev, next } = getDocSiblings(currentId);
const toc = headings.filter((h) => h.depth === 2);
const hasToc = toc.length >= 2;
const onTagsSection = pathname.startsWith('/docs/tags');
const related = tags.length > 0 ? await getRelatedByTags(pathname, tags) : [];

const formattedUpdated = lastUpdated
  ? new Date(lastUpdated).toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
    })
  : '';
---

<BaseLayout title={title}>
  <div class="docs-shell">
    <aside class="docs-nav" aria-label="Documentation navigation">
      <div class="docs-nav-inner">
        {
          DOC_NAV.map((section) => (
            <div class="docs-nav-group">
              <div class="docs-nav-glabel">{section.group}</div>
              {section.items.map((item) => (
                <a
                  href={item.href}
                  class:list={['docs-nav-item', { on: currentId === item.id }]}
                  aria-current={currentId === item.id ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ))}
            </div>
          ))
        }
        <div class="docs-nav-footer">
          <a
            href={tagsIndexHref()}
            class:list={['docs-nav-item', 'docs-nav-tags', { on: onTagsSection }]}
            aria-current={onTagsSection ? 'page' : undefined}
          >
            Browse tags
          </a>
        </div>
      </div>
    </aside>

    <div class="docs-main" id="docs-content" tabindex="-1" role="region" aria-label="Documentation article">
      <article class="docs-article fade-up" aria-label={title}>
        <div class="docs-eyebrow">Documentation</div>
        <h1 class="docs-title">{title}</h1>
        {description && <p class="docs-desc">{description}</p>}
        {
          (minutesRead || tags.length > 0) && (
            <div class="docs-meta">
              {
                minutesRead && (
                  <span class="stat">
                    <Icon name="clock" size={13} />
                    {minutesRead}
                  </span>
                )
              }
              {tags.length > 0 && <TagList tags={tags} class="docs-meta-tags" />}
            </div>
          )
        }
        <div class="docs-divider-full" aria-hidden="true"></div>

        <div class="docs-body doc-prose">
          <slot />
        </div>

        <DocPager prev={prev} next={next} />

        {
          related.length > 0 && (
            <section class="docs-related" aria-labelledby="docs-related-heading">
              <h2 id="docs-related-heading" class="docs-related-heading">Related</h2>
              <DocList
                layout="grid"
                pages={related.map((d) => ({
                  title: d.title,
                  description: d.description,
                  url: d.url,
                }))}
                emptyText=""
              />
            </section>
          )
        }

        <footer class="docs-article-footer">
          {
            formattedUpdated && (
              <span class="stat docs-footer-updated">
                <Icon name="check" size={13} />
                Updated {formattedUpdated}
              </span>
            )
          }
          <PageFeedback pageTitle={title} bare />
        </footer>
      </article>
    </div>

    {
      hasToc && (
        <aside class="docs-toc" aria-label="On this page">
          <div class="docs-toc-label">On this page</div>
          <nav>
            {toc.map((h) => (
              <a
                href={`#${h.slug}`}
                class="docs-toc-item"
                data-toc-link={h.slug}
              >
                {h.text}
              </a>
            ))}
          </nav>
        </aside>
      )
    }
  </div>
</BaseLayout>

{
  hasToc && (
    <script>
      const links = new Map<string, HTMLAnchorElement>();
      document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]').forEach((a) => {
        const slug = a.getAttribute('data-toc-link');
        if (slug) links.set(slug, a);
      });
      const heads = [...links.keys()]
        .map((slug) => document.getElementById(slug))
        .filter((el): el is HTMLElement => el !== null);

      let current = '';
      const setCurrent = (slug: string) => {
        if (slug === current) return;
        current = slug;
        links.forEach((a, s) => {
          a.classList.toggle('on', s === slug);
          a.setAttribute('aria-current', s === slug ? 'true' : 'false');
        });
      };

      if (heads.length && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            const visible = entries
              .filter((e) => e.isIntersecting)
              .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
            if (visible[0]?.target.id) setCurrent(visible[0].target.id);
          },
          { rootMargin: '0px 0px -70% 0px', threshold: 0 },
        );
        heads.forEach((el) => observer.observe(el));
      }
    </script>
  )
}
