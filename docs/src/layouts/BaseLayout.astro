---
import '../styles/docs.css';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
const pageTitle = title ? `${title} — Interop Docs` : 'Interop Docs';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <!-- External (same-origin) theme-boot so it runs under a strict
         `script-src 'self'` CSP without FOUC. See public/docs/theme-init.js. -->
    <script is:inline src="/docs/theme-init.js"></script>
  </head>
  <body>
    <div class="app">
      <SiteHeader activeNav="docs" />
      <main class="app-main">
        <slot />
      </main>
    </div>
  </body>
</html>
