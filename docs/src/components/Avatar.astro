---
interface Props {
  name: string;
  size?: number;
  round?: boolean;
}

const { name, size = 30, round = false } = Astro.props;
const initials = name
  .split(/[\s/]/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0])
  .join('')
  .toUpperCase();
const radius = round ? size / 2 : 6;
---

<span
  class="avatar"
  style={`width:${size}px;height:${size}px;font-size:${size * 0.42}px;border-radius:${radius}px`}
  aria-label={name}
  role="img"
  id="hdr-avatar"
>
  {initials}
</span>
