---
import { ICON_PATHS, type IconName } from '../lib/icons';

interface Props {
  name: IconName;
  size?: number;
}

const { name, size = 16 } = Astro.props;
const paths = ICON_PATHS[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths}
/>
