# Canonical site URL (sitemap, absolute links). Optional for local dev.
# SITE_URL=https://registry.example.com

# Backend URL for Astro dev server API proxy (page feedback widget).
# BACKEND_URL=http://localhost:3000

# Registry app origin for header links during `npm run dev` (see .env.development).
# Leave unset in production — nginx serves docs and the app from the same origin.
# PUBLIC_APP_ORIGIN=http://localhost:4200
