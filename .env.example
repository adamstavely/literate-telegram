# Root compose environment — copy to .env before `docker compose up`.
# Backend-specific variables are documented in backend/.env.example.

NODE_ENV=development

# Elasticsearch (compose service name)
ES_NODE=http://elasticsearch:9200
ES_USERNAME=elastic
ES_PASSWORD=changeme

# OIDC — use real values in production (see backend/.env.example)
OIDC_ISSUER=https://your-tenant.auth0.com/
OIDC_AUDIENCE=https://api.interop.io
OIDC_JWKS_URI=https://your-tenant.auth0.com/.well-known/jwks.json

# Dev-only mock auth — never enable in shared/production environments
ALLOW_MOCK_AUTH=false

# Trust proxy only when traffic arrives through the nginx frontend proxy.
# Do not expose backend :3000 directly while TRUST_PROXY=1 (XFF spoofing risk).
TRUST_PROXY=1

ALLOWED_ORIGINS=http://localhost:4200

LOG_LEVEL=info
LOG_INDEX=interop-logs
AUDIT_INDEX=interop-audit
