NODE_ENV=development
PORT=3000

# Elasticsearch
ES_NODE=http://localhost:9200
ES_USERNAME=elastic
ES_PASSWORD=changeme
ES_CA_FINGERPRINT=

# OIDC / Auth
# In production these must be set to real values (the app refuses to start with
# the your-tenant.* placeholders).
OIDC_ISSUER=https://your-tenant.auth0.com/
OIDC_AUDIENCE=https://api.interop.io
OIDC_JWKS_URI=https://your-tenant.auth0.com/.well-known/jwks.json

# Dev-only: accept the "mock-token" bearer as an admin user. Ignored unless
# NODE_ENV=development. Never enable in a shared or production environment.
ALLOW_MOCK_AUTH=false

# Express "trust proxy" setting. Only set this when actually behind a trusted
# proxy/load balancer — it controls whether X-Forwarded-For is honored for
# req.ip (rate limiting + audit attribution). Examples: false, true, 1, loopback.
TRUST_PROXY=false

# CORS
ALLOWED_ORIGINS=http://localhost:4200,https://interop.io

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
# Tighter per-IP budget for unauthenticated client telemetry ingestion
# (POST /api/logs, POST /api/audit/client).
INGEST_RATE_LIMIT_WINDOW_MS=60000
INGEST_RATE_LIMIT_MAX=30

# Logging
LOG_LEVEL=info
LOG_INDEX=interop-logs
AUDIT_INDEX=interop-audit
