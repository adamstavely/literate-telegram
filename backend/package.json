{
  "name": "@interop/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "seed": "tsx src/elasticsearch/seed.ts",
    "lint": "eslint src",
