  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@elastic/elasticsearch": "^8.13.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jose": "^5.3.0",
    "js-yaml": "^5.2.1",
    "undici": "^6.27.0",
    "uuid": "^11.1.1",
    "winston": "^3.13.0",
    "winston-transport": "^4.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.12.7",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.39.2",
    "openapi-types": "^12.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.7.3",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.50.1"
  },
  "overrides": {
    "@opentelemetry/core": "^2.8.0",
    "esbuild": "^0.28.1"
  }
